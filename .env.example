# Copy to .env (in the folder you run from). Same names as the SmartNet ML project.
# What this device does: p2p or lorawan
LORA_MODE=p2p
# P2P only: gateway or node
LORA_ROLE=gateway
LORA_SERIAL_PORT=/dev/ttyUSB0
LORA_ADDRESS=1
LORA_GATEWAY_ADDRESS=1
LORA_FREQUENCY=915000000
LORA_SPREADING_FACTOR=7
LORA_BANDWIDTH=0
LORA_CODING_RATE=0
LORA_PREAMBLE=8
LORA_TX_POWER=22
LORA_VERBOSE=false

# LoRaWAN OTAA
LORAWAN_DEVEUI=
LORAWAN_JOINEUI=
LORAWAN_APPKEY=
# LoRaWAN ABP (if LORAWAN_DEVADDR is set, ABP is used)
LORAWAN_DEVADDR=
LORAWAN_NWKSKEY=
LORAWAN_APPSKEY=
LORAWAN_FPORT=2
